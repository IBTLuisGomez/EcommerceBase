package com.ecommerce.shared.infrastructure.multitenancy;

import com.ecommerce.shared.domain.TenantId;

public final class TenantContext {
    private static final ThreadLocal<TenantId> CURRENT = new ThreadLocal<>();

    public static void set(TenantId tenantId) {
        CURRENT.set(tenantId);
    }

    public static TenantId get() {
        TenantId id = CURRENT.get();
        if (id == null) {
            throw new IllegalStateException("No tenant set in context");
        }
        return id;
    }

    public static void clear() {
        CURRENT.remove();
    }
}